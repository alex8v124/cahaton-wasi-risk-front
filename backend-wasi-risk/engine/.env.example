# Copiar como .env o exportar en el VPS de Soe Macero
# Si DEEPSEEK_API_KEY queda vacio, el servidor corre en modo determinista local (cero fallas en demo)
DEEPSEEK_API_KEY=sk-REEMPLAZAR_CON_TU_API_KEY_DEEPSEEK
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SEC=12.0
PORT=8000
